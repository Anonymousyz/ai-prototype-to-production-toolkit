{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Prototype Readiness Assessment",
  "type": "object",
  "required": ["system_name", "scores", "max_scores", "veto_items", "top_gaps"],
  "properties": {
    "system_name": {"type": "string"},
    "stage": {"type": "string"},
    "scores": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0}
    },
    "max_scores": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 1}
    },
    "veto_items": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "top_gaps": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
